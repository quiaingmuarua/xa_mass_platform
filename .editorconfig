root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf

[*.bat]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{java,xml,yml,yaml,json,html,js,ts,css}]
indent_style = space
indent_size = 4
