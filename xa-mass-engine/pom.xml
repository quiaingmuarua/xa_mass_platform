<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.xa.mass</groupId>
        <artifactId>xa_mass_platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>xa-mass-engine</artifactId>
    <packaging>jar</packaging>
    <name>xa-mass-engine</name>
    <dependencies>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>QLExpress</artifactId>
            <version>3.3.2</version>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.2-jre</version>
        </dependency>

        <dependency>
            <groupId>com.xa.mass</groupId>
            <artifactId>xa-mass-core</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testExcludes>
                        <!-- Historical v2 tests/examples depend on a removed messaging package tree -->
                        <testExclude>**/com/xa/mass/engine/v2/dao/MessageMapProviderRegistryTest.java</testExclude>
                        <testExclude>**/com/xa/mass/engine/v2/dao/TaskRepositoryManagerTest.java</testExclude>
                        <testExclude>**/com/xa/mass/engine/v2/integration/DataFlowIntegrationTest.java</testExclude>
                        <testExclude>**/com/xa/mass/engine/v2/example/**/*.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/com/xa/mass/engine/v2/dao/MessageMapProviderRegistryTest.java</exclude>
                        <exclude>**/com/xa/mass/engine/v2/dao/TaskRepositoryManagerTest.java</exclude>
                        <exclude>**/com/xa/mass/engine/v2/integration/DataFlowIntegrationTest.java</exclude>
                        <exclude>**/com/xa/mass/engine/v2/example/**/*.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project> 
