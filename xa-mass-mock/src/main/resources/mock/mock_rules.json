[
  {
    "id": "rule-1",
    "desc": "设备必须属于美国或英国分组",
    "content": "device.groupId == 'us' || device.groupId == 'gb'",
    "enabled": true
  },
  {
    "id": "rule-2",
    "desc": "设备版本必须大于等于1.0.0",
    "content": "device.agentVersion >= '1.0.0'",
    "enabled": true
  },
  {
    "id": "rule-3",
    "desc": "设备支持的项目必须包含demoApp",
    "content": "'demoApp' in device.supportedApps",
    "enabled": true
  }
] 