[
  {
    "MODEL": "RuleDefinition",
    "COUNT": 3,
    "FIELDS": {
      "id": {
        "$JOIN": [
          "rule-",
          "&.index"
        ]
      },
      "name": {
        "$JOIN": [
          "瑙勫垯-",
          "&.index"
        ]
      },
      "description": {
        "$JOIN": [
          "鎻忚堪-",
          "&.index"
        ]
      },
      "type": null,
      "content": {
        "$CHOICE": [
          "device.deviceGroupId == 'us' || device.deviceGroupId == 'gb'",
          "device.agentVersion >= '1.0.0'",
          "'demoApp' in device.supportedProjects"
        ]
      },
      "priority": {
        "$RANGE": [
          1,
          3
        ]
      },
      "enabled": true
    }
  }
] 