{
  "schemaVersion": 1,
  "workflowPolicy": {
    "prGate": false,
    "lane": "scheduled/manual",
    "comparisonTarget": "latest green scheduled or manually dispatched artifact",
    "thresholdPolicy": "Only runner pass/fail invariants are hard thresholds in this slice; latency and throughput values are trend-only until a calibrated baseline exists.",
    "releaseInterpretation": "Release confidence may cite the latest green perf-smokes and soak-smokes summaries plus their source reports, but PRs are not blocked by these trend lanes."
  },
  "stableScenarios": [
    {
      "scenarioId": "workload-mix-slow-bulk-interactive-isolation",
      "lane": "perf",
      "workflow": "perf-smokes",
      "runner": "com.xa.mass.testing.perf.TaskWorkloadMixSmokeRunner",
      "reportGlob": "xa-mass-testing/target/perf-reports/task-workload-mix-smoke-*.json",
      "thresholdSignals": [
        {
          "name": "interactive dispatched before bulk terminal",
          "path": "observation.interactiveDispatchedBeforeBulkTerminal",
          "expect": true
        },
        {
          "name": "interactive dispatched while bulk task still running",
          "path": "observation.interactiveDispatchedWhileBulkTaskStillRunning",
          "expect": true
        },
        {
          "name": "bulk terminal reason",
          "path": "observation.bulkTerminalReason",
          "expect": "ALL_MESSAGES_SUCCEEDED"
        },
        {
          "name": "interactive terminal reason",
          "path": "observation.interactiveTerminalReason",
          "expect": "ALL_MESSAGES_SUCCEEDED"
        }
      ],
      "trendSignals": [
        {
          "name": "bulk first dispatch latency",
          "path": "observation.bulkFirstDispatchMillis",
          "unit": "ms"
        },
        {
          "name": "interactive first dispatch latency",
          "path": "observation.interactiveFirstDispatchMillis",
          "unit": "ms"
        },
        {
          "name": "bulk terminal latency",
          "path": "observation.bulkTerminalMillis",
          "unit": "ms"
        },
        {
          "name": "interactive terminal latency",
          "path": "observation.interactiveTerminalMillis",
          "unit": "ms"
        }
      ]
    },
    {
      "scenarioId": "interactive-retry-wakeup",
      "lane": "perf",
      "workflow": "perf-smokes",
      "runner": "com.xa.mass.testing.perf.TaskInteractiveRetryWakeupSmokeRunner",
      "reportGlob": "xa-mass-testing/target/perf-reports/task-interactive-retry-wakeup-smoke-*.json",
      "thresholdSignals": [
        {
          "name": "retry dispatch delay respects configured wakeup floor",
          "path": "observation.interactiveRetryDispatchDelayMillis",
          "gteConfigPath": "config.minRetryDispatchDelayMillis"
        },
        {
          "name": "interactive retry dispatched before bulk terminal",
          "path": "observation.interactiveRetryDispatchedBeforeBulkTerminal",
          "expect": true
        },
        {
          "name": "interactive retry dispatched while bulk task still running",
          "path": "observation.interactiveRetryDispatchedWhileBulkTaskStillRunning",
          "expect": true
        },
        {
          "name": "bulk terminal reason",
          "path": "observation.bulkTerminalReason",
          "expect": "ALL_MESSAGES_SUCCEEDED"
        },
        {
          "name": "interactive terminal reason",
          "path": "observation.interactiveTerminalReason",
          "expect": "ALL_MESSAGES_SUCCEEDED"
        }
      ],
      "trendSignals": [
        {
          "name": "interactive first dispatch latency",
          "path": "observation.interactiveFirstDispatchMillis",
          "unit": "ms"
        },
        {
          "name": "interactive retry dispatch latency",
          "path": "observation.interactiveRetryDispatchMillis",
          "unit": "ms"
        },
        {
          "name": "interactive retry dispatch delay",
          "path": "observation.interactiveRetryDispatchDelayMillis",
          "unit": "ms"
        },
        {
          "name": "bulk callbacks in flight at retry dispatch",
          "path": "observation.bulkCallbacksInFlightAtInteractiveRetryDispatch",
          "unit": "count"
        }
      ]
    },
    {
      "scenarioId": "polling-soak-noisy-mixed-result",
      "lane": "soak",
      "workflow": "soak-smokes",
      "runner": "com.xa.mass.testing.soak.SdkPollingSchedulingSoakRunner",
      "reportGlob": "xa-mass-testing/target/soak-reports/polling-scheduling-soak-*.json",
      "thresholdSignals": [
        {
          "name": "runtime invariants",
          "path": "proof.runtimeInvariants.ok",
          "expect": true
        },
        {
          "name": "active lease drain",
          "path": "activeLeasesAtEnd",
          "expect": 0
        },
        {
          "name": "trace dropped count",
          "path": "proof.trace.droppedCount",
          "expect": 0
        },
        {
          "name": "runtime expired work items",
          "path": "runtimeWork.expiredWorkItems",
          "expect": 0
        }
      ],
      "trendSignals": [
        {
          "name": "tasks submitted",
          "path": "tasksSubmitted",
          "unit": "count"
        },
        {
          "name": "work items submitted",
          "path": "workItemsSubmitted",
          "unit": "count"
        },
        {
          "name": "successful work items",
          "path": "runtimeWork.successWorkItems",
          "unit": "count"
        },
        {
          "name": "failed work items",
          "path": "runtimeWork.failedWorkItems",
          "unit": "count"
        },
        {
          "name": "worker total processing time",
          "path": "proof.workerMetrics.totalProcessingMillis",
          "unit": "ms"
        }
      ]
    }
  ]
}
