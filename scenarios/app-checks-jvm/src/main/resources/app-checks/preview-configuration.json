{
  "common": {
    "typeDefaults": {
      "simulated-registration-v1": {
        "ranges": {
          "registered": [
            0,
            500
          ],
          "unregistered": [
            500,
            900
          ],
          "failed": [
            900,
            1000
          ]
        },
        "delayMs": [
          2000,
          5000
        ]
      },
      "registration-v1": {},
      "original-carrier-v1": {},
      "uint32-prime-v1": {},
      "md5-prefix-demo-v1": {},
      "original-carrier-batch-v1": {},
      "md5-prefix-demo-batch-v1": {}
    }
  },
  "checks": {
    "app-a-registration": {
      "label": "App A 模拟注册",
      "workerGroupId": "app-a-sim",
      "execution": {
        "eventCode": "extension.worker.app.registration.check",
        "refill": [
          {
            "poolName": "assignment-window",
            "target": {},
            "count": 100
          }
        ],
        "workerSelector": {
          "executorName": "worker.assignment.available",
          "input": {}
        },
        "seedsPerItem": 1
      },
      "checkType": "simulated-registration-v1"
    },
    "app-b-registration": {
      "label": "App B 模拟注册",
