{
  "common": {
    "typeDefaults": {
      "simulated-registration-v1": {
        "ranges": {
          "registered": [
            0,
            500
          ],
          "unregistered": [
            500,
            900
          ],
          "failed": [
            900,
            1000
          ]
        },
        "delayMs": [
          2000,
          5000
        ]
      },
      "registration-v1": {},
      "original-carrier-v1": {}
    }
  },
  "checks": {
    "app-a-registration": {
      "label": "App A",
      "workerGroupId": "app-a-sim",
      "execution": {
        "eventCode": "extension.worker.app.registration.check",
        "refill": [
          {
            "poolName": "assignment-window",
            "target": {},
            "count": 100
          }
        ],
        "workerSelector": {
          "executorName": "worker.assignment.available",
          "input": {}
        }
      },
      "checkType": "simulated-registration-v1"
    },
    "app-a-carrier": {
      "label": "App A",
      "checkType": "original-carrier-v1",
      "workerGroupId": "app-a-sim",
      "execution": {
        "eventCode": "extension.worker.phonenumber.original-carrier",
        "refill": [
          {
            "poolName": "any",
            "target": {},
            "count": 100
          }
        ],
        "workerSelector": {
          "executorName": "worker.any",
          "input": {}
        }
      }
    },
    "app-b-registration": {
      "label": "App B",
      "workerGroupId": "app-b-sim",
      "execution": {
        "eventCode": "extension.worker.app.registration.check",
        "refill": [
          {
            "poolName": "assignment-window",
            "target": {},
            "count": 100
          }
        ],
        "workerSelector": {
          "executorName": "worker.assignment.available",
          "input": {}
        }
      },
      "checkType": "simulated-registration-v1"
    },
    "app-b-carrier": {
      "label": "App B",
      "checkType": "original-carrier-v1",
      "workerGroupId": "app-b-sim",
      "execution": {
        "eventCode": "extension.worker.phonenumber.original-carrier",
        "refill": [
          {
            "poolName": "any",
            "target": {},
            "count": 100
          }
        ],
        "workerSelector": {
          "executorName": "worker.any",
          "input": {}
        }
      }
    }
  },
  "poolGroups": {
    "app-a-sim": {
      "windowMillis": 60000,
      "maxCount": 10
    },
    "app-b-sim": {
      "windowMillis": 60000,
      "maxCount": 10
    }
  }
}
