<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="Worker Score diagnosis" description="Owner evidence only; raw recordings stay private" provider="XA Mass">
  <event name="xa.mass.WorkerScoreDiagnostic"><setting name="enabled">true</setting><setting name="threshold">0 ns</setting><setting name="stackTrace">false</setting></event>
  <event name="xa.mass.WorkerEvidenceDiagnostic"><setting name="enabled">true</setting><setting name="threshold">0 ns</setting><setting name="stackTrace">false</setting></event>
  <event name="jdk.DataLoss"><setting name="enabled">true</setting></event>
</configuration>
