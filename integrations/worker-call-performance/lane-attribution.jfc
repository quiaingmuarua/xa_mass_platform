<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="XA Mass performance lane attribution" description="Dispatch Owner stage events only; no sampling" provider="XA Mass">
  <event name="xa.mass.TaskDispatch"><setting name="enabled">true</setting></event>
  <event name="xa.mass.TaskSubmission"><setting name="enabled">true</setting></event>
  <event name="xa.mass.TaskResult"><setting name="enabled">true</setting></event>
  <event name="jdk.CPULoad"><setting name="enabled">true</setting><setting name="period">1 s</setting></event>
  <event name="jdk.GarbageCollection"><setting name="enabled">true</setting></event>
  <event name="jdk.DataLoss"><setting name="enabled">true</setting></event>
</configuration>
