{
  "events": [
    {
      "code": "probe.weather.current",
      "name": "Weather Current Probe",
      "description": "Fetches or validates current weather JSON and checks required weather fields.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["publicProbe"]
    },
    {
      "code": "probe.fx.latest",
      "name": "FX Latest Probe",
      "description": "Fetches or validates latest FX rates and checks selected positive currency rates.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["publicProbe"]
    },
    {
      "code": "probe.crypto.price",
      "name": "Crypto Price Probe",
      "description": "Fetches or validates selected crypto prices and checks positive numeric values.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["publicProbe"]
    },
    {
      "code": "probe.ip.geo",
      "name": "IP Geo Probe",
      "description": "Checks egress or target IP metadata such as country and ASN facts.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["publicProbe"]
    },
    {
      "code": "probe.url.dns",
      "name": "URL DNS Probe",
      "description": "Parses URLs and classifies DNS, timeout, TLS, and HTTP reachability outcomes.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["publicProbe"]
    },
    {
      "code": "probe.http.status",
      "name": "HTTP Status Probe",
      "description": "Checks HTTP status, delay, headers, timeout, and retry behavior.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["publicProbe"]
    },
    {
      "code": "probe.phone.metadata",
      "name": "Phone Metadata Probe",
      "description": "Parses phone numbers into E.164, region, type, and possible/valid metadata.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["deviceProbe"]
    },
    {
      "code": "probe.market.daily-csv",
      "name": "Market Daily CSV Probe",
      "description": "Validates market CSV columns and latest positive close price values.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["dataQualityProbe"]
    },
    {
      "code": "probe.csv.validate",
      "name": "CSV Validate Probe",
      "description": "Validates local CSV shape, row count, required columns, and numeric ranges.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["dataQualityProbe"]
    },
    {
      "code": "probe.json.schema",
      "name": "JSON Schema Probe",
      "description": "Validates local JSON fixtures against required fields and type checks.",
      "payloadTypes": ["JSON"],
      "taskModes": ["SINGLE_RUN", "STREAMING"],
      "projectCodes": ["dataQualityProbe"]
    }
  ],
  "projects": [
    {
      "code": "publicProbe",
      "name": "Public Probe",
      "description": "Public API, DNS, HTTP, price, and network reachability probes.",
      "eventCodes": [
        "probe.weather.current",
        "probe.fx.latest",
        "probe.crypto.price",
        "probe.ip.geo",
        "probe.url.dns",
        "probe.http.status"
      ]
    },
    {
      "code": "deviceProbe",
      "name": "Device Probe",
      "description": "Phone metadata and device fingerprint routing probes.",
      "eventCodes": ["probe.phone.metadata"]
    },
    {
      "code": "dataQualityProbe",
      "name": "Data Quality Probe",
      "description": "Local CSV and JSON validation probes.",
      "eventCodes": [
        "probe.market.daily-csv",
        "probe.csv.validate",
        "probe.json.schema"
      ]
    }
  ],
  "apiKeys": [
    {
      "principalId": "public-probe-runner",
      "devOnly": true,
      "rawSecret": "public-probe-key",
      "createdForUserId": "ops-admin",
      "permissions": ["task:create", "task:edit", "task:view"],
      "projectScopes": ["publicProbe"],
      "eventScopes": [
        "probe.weather.current",
        "probe.fx.latest",
        "probe.crypto.price",
        "probe.ip.geo",
        "probe.url.dns",
        "probe.http.status"
      ],
      "attributes": {
        "label": "Public Probe Runner"
      }
    },
    {
      "principalId": "device-probe-runner",
      "devOnly": true,
      "rawSecret": "device-probe-key",
      "createdForUserId": "ops-admin",
      "permissions": ["task:create", "task:edit", "task:view"],
      "projectScopes": ["deviceProbe"],
      "eventScopes": ["probe.phone.metadata"],
      "attributes": {
        "label": "Device Probe Runner"
      }
    },
    {
      "principalId": "data-quality-runner",
      "devOnly": true,
      "rawSecret": "data-quality-key",
      "createdForUserId": "ops-admin",
      "permissions": ["task:create", "task:edit", "task:view"],
      "projectScopes": ["dataQualityProbe"],
      "eventScopes": [
        "probe.market.daily-csv",
        "probe.csv.validate",
        "probe.json.schema"
      ],
      "attributes": {
        "label": "Data Quality Runner"
      }
    },
    {
      "principalId": "public-probe-reviewer",
      "devOnly": true,
      "rawSecret": "public-probe-reviewer-key",
      "createdForUserId": "ops-admin",
      "permissions": ["task:govern"],
      "projectScopes": ["publicProbe", "deviceProbe", "dataQualityProbe"],
      "eventScopes": [
        "probe.weather.current",
        "probe.fx.latest",
        "probe.crypto.price",
        "probe.ip.geo",
        "probe.url.dns",
        "probe.http.status",
        "probe.phone.metadata",
        "probe.market.daily-csv",
        "probe.csv.validate",
        "probe.json.schema"
      ],
      "attributes": {
        "label": "Public Probe Reviewer"
      }
    },
    {
      "principalId": "public-probe-ops",
      "devOnly": true,
      "rawSecret": "public-probe-ops-key",
      "createdForUserId": "ops-admin",
      "permissions": ["worker:poll", "task:create", "task:edit", "task:control", "task:govern"],
      "projectScopes": ["publicProbe", "deviceProbe", "dataQualityProbe"],
      "eventScopes": [
        "probe.weather.current",
        "probe.fx.latest",
        "probe.crypto.price",
        "probe.ip.geo",
        "probe.url.dns",
        "probe.http.status",
        "probe.phone.metadata",
        "probe.market.daily-csv",
        "probe.csv.validate",
        "probe.json.schema"
      ],
      "attributes": {
        "label": "Public Probe Ops"
      }
    }
  ]
}
