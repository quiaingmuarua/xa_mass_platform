{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:demo",
  "outputDirectory": "dist-demo",
  "ignoreCommand": "node docs/ignored-build.mjs",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs/index.html"
    },
    {
      "source": "/((?!docs(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
