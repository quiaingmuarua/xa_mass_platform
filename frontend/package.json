  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
