        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.5.1",
        "globals": "^16.4.0",
        "jsdom": "^27.2.0",
        "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.9",
